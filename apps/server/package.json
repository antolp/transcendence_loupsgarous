    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@ft/contracts": "0.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "zod": "^3.25.76",
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "tsx": "^4.20.3",
    "prisma": "6.19.0"
  }
}
