# Local development only; copy to .env at the repository root.
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001

# PostgreSQL credentials must match the Docker Compose service, eventually all of this will be rewritten
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://werewolf:local_dev_only@127.0.0.1:5432/werewolf_dev?schema=public
